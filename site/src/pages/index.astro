---
import Base from "../layouts/Base.astro";
// Kept as raw html so the markup that is already indexed ships byte for byte.
import body from "../html/index.html?raw";

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://campuscli.com/#organization",
    "name": "Campus",
    "alternateName": [
      "Campus CLI",
      "campus-cli",
      "blackboard-cli",
      "Campus Profes"
    ],
    "url": "https://campuscli.com/",
    "logo": "https://campuscli.com/assets/campus-logo.webp",
    "description": "Campus construye herramientas independientes para estudiantes universitarios en Perú: Campus CLI conecta Blackboard UPC con asistentes de IA, y Campus Profes ayuda a elegir profesor por WhatsApp.",
    "disambiguatingDescription": "No confundir con el paquete `campus-cli` de PyPI (Python, gestión de notebooks Jupyter) ni con otras plataformas de IA para estudiantes con nombres similares (CampusCode, Campus AI).",
    "sameAs": [
      "https://github.com/alejooroncoy/campus-cli"
    ],
    "areaServed": "PE"
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://campuscli.com/#website",
    "name": "Campus",
    "url": "https://campuscli.com/",
    "inLanguage": "es-PE",
    "publisher": {
      "@id": "https://campuscli.com/#organization"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Productos de Campus",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Campus CLI",
        "description": "Conecta Blackboard UPC con ChatGPT, Claude o la terminal.",
        "url": "https://campuscli.com/campus-cli/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Campus Profes",
        "description": "Calificaciones, comentarios y horarios de profesores por WhatsApp.",
        "url": "https://campuscli.com/profes/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "¿Campus CLI y Campus Profes son el mismo producto?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. Son dos productos independientes de Campus. Campus CLI conecta tu Aula Virtual (Blackboard UPC) con ChatGPT, Claude o la terminal. Campus Profes es un bot de WhatsApp para elegir profesor antes de matricularte. Puedes usar uno, el otro, o ambos."
        }
      },
      {
        "@type": "Question",
        "name": "¿Cuál debería usar?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Si quieres consultar tus cursos, tareas y notas de Blackboard, usa Campus CLI. Si estás por matricularte y quieres saber cómo califican a un profesor, usa Campus Profes."
        }
      },
      {
        "@type": "Question",
        "name": "¿Quién está detrás de Campus?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Campus lo construye Alejandro Oroncoy, estudiante de Ingeniería de Software en la UPC."
        }
      },
      {
        "@type": "Question",
        "name": "¿Es lo mismo que el paquete \"campus-cli\" de PyPI u otras apps de IA para estudiantes?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. El paquete campus-cli de PyPI es un proyecto de Python no relacionado (gestión de archivos de notebooks Jupyter), y tampoco somos otras plataformas de \"IA para resolver tareas\" con nombres parecidos. Este Campus es el paquete campus-cli de npm; el código fuente está en github.com/alejooroncoy/campus-cli."
        }
      }
    ]
  }
];
---

<Base
  title={"Campus | Herramientas independientes para tu vida universitaria"}
  description={"Campus construye herramientas independientes para estudiantes: Campus CLI conecta tu Aula Virtual con ChatGPT y Claude, y Campus Profes te ayuda a elegir profesor por WhatsApp."}
  canonical={"https://campuscli.com/"}
  markdownUrl={"https://campuscli.com/index.md"}
  ogTitle={"Campus | Campus CLI y Campus Profes"}
  ogDescription={"Dos productos independientes para estudiantes: Blackboard UPC en tu asistente de IA, y calificaciones de profesores por WhatsApp."}
  ogImageAlt={"Campus: Campus CLI y Campus Profes"}
  schemas={schemas}
>
  <Fragment set:html={body} />
</Base>
