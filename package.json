{
  "name": "campus-cli",
  "version": "1.4.1",
  "description": "Conecta Blackboard UPC con ChatGPT y Claude vía MCP, o úsalo desde la terminal — CLI/MCP no oficial para el campus universitario (Blackboard, Canvas, Moodle...)",
  "mcpName": "io.github.alejooroncoy/campus-cli",
  "main": "run.js",
  "exports": {
    ".": "./run.js",
    "./session": "./dist/providers/blackboard/auth/session.js",
    "./login": "./dist/providers/blackboard/auth/login.js",
    "./client": "./dist/providers/blackboard/api/client.js",
    "./courses": "./dist/providers/blackboard/api/courses.js",
    "./assignments-api": "./dist/providers/blackboard/api/assignments.js",
    "./assignments": "./dist/providers/blackboard/commands/assignments.js",
    "./types": "./dist/providers/blackboard/types.js",
    "./mcp-tools": "./dist/providers/blackboard/mcp-tools.js",
    "./analytics": "./dist/analytics.js"
  },
  "files": [
    "dist",
    "run.js",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "campus": "run.js",
    "campus-cli": "run.js",
    "blackboard": "run.js",
    "blackboard-upc": "run.js"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "prepublishOnly": "npm run build",
    "test": "tsx --test tests/**/*.test.ts",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "keywords": [
    "campus",
    "campus-cli",
    "campuscli",
    "blackboard",
    "canvas",
    "moodle",
    "upc",
    "aula-virtual",
    "cli",
    "mcp",
    "model-context-protocol",
    "claude",
    "chatgpt",
    "lms",
    "peru"
  ],
  "author": "Alejandro Oroncoy",
  "homepage": "https://campuscli.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alejooroncoy/campus-cli.git"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@browserbasehq/sdk": "^2.16.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^22.0.0",
    "axios": "^1.7.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "form-data": "^4.0.5",
    "google-auth-library": "^9.15.1",
    "inquirer": "^10.1.0",
    "ora": "^8.1.0",
    "playwright": "^1.47.0",
    "playwright-core": "^1.62.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0"
  }
}
