{
  "manifest_version": 3,
  "name": "Campus",
  "description": "Extensión de Campus para Class y Blackboard.",
  "version": "0.1.0",
  "permissions": ["storage", "sidePanel", "scripting"],
  "host_permissions": [
    "https://upc.class.com/*",
    "https://aulavirtual.upc.edu.pe/*"
  ],
  "action": {
    "default_title": "Abrir Campus"
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://upc.class.com/*"],
    "js": ["captions.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
